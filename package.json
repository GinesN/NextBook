{
  "name": "nextbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/bundle-auth.mjs && vite --config vite.github-pages.config.ts",
    "build": "pnpm run build:github-pages",
    "build:github-pages": "node scripts/bundle-auth.mjs && vite build --config vite.github-pages.config.ts && node scripts/harden-pages.mjs && node scripts/check-pages.mjs",
    "build:cloudflare": "node scripts/bundle-auth.mjs && vite build --config vite.cloudflare.config.ts && node scripts/prepare-cloudflare-pages.mjs && node scripts/harden-pages.mjs cloudflare-pages-dist --headers && node scripts/check-pages.mjs cloudflare-pages-dist /",
    "start": "vite preview --config vite.github-pages.config.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "pnpm exec tsc --noEmit && pnpm run lint && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "qrcode": "1.5.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "type": "module"
}
